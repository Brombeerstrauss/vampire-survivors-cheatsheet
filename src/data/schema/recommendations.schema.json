{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recommendations per character",
  "type": "object",
  "required": ["recommendations"],
  "additionalProperties": false,
  "definitions": {
    "item": {
      "type": "object",
      "required": ["id", "reason", "priority"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/definitions/id" },
        "reason": {
          "$ref": "common.schema.json#/definitions/localizedText",
          "description": "Short reason, e.g. synergy with the character's bonus."
        },
        "priority": {
          "enum": [1, 2, 3],
          "description": "1 = core of the build, 2 = good addition, 3 = optional."
        }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["character", "source", "weapons", "passives"],
        "additionalProperties": false,
        "properties": {
          "character": { "$ref": "common.schema.json#/definitions/id" },
          "source": { "$ref": "common.schema.json#/definitions/source" },
          "summary": { "$ref": "common.schema.json#/definitions/localizedText", "description": "Play style in one or two sentences." },
          "weapons": { "type": "array", "items": { "$ref": "#/definitions/item" } },
          "passives": { "type": "array", "items": { "$ref": "#/definitions/item" } },
          "avoid": {
            "type": "array",
            "description": "Weapons or items the wiki clearly advises against for this character.",
            "items": {
              "type": "object",
              "required": ["id", "reason"],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "common.schema.json#/definitions/id" },
                "reason": { "$ref": "common.schema.json#/definitions/localizedText" }
              }
            }
          }
        }
      }
    }
  }
}
