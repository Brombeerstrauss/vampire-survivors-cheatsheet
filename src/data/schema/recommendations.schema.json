{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Empfehlungen pro Charakter",
  "type": "object",
  "required": ["recommendations"],
  "additionalProperties": false,
  "definitions": {
    "item": {
      "type": "object",
      "required": ["id", "reason", "priority"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/definitions/id" },
        "reason": {
          "$ref": "common.schema.json#/definitions/text",
          "description": "Kurze Begründung, z. B. Synergie mit dem Bonus des Charakters."
        },
        "priority": {
          "enum": [1, 2, 3],
          "description": "1 = Kern des Builds, 2 = gute Ergänzung, 3 = optional."
        }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["character", "source", "weapons", "passives"],
        "additionalProperties": false,
        "properties": {
          "character": { "$ref": "common.schema.json#/definitions/id" },
          "source": { "$ref": "common.schema.json#/definitions/source" },
          "summary": { "type": "string", "description": "Spielstil in ein bis zwei Sätzen." },
          "weapons": { "type": "array", "items": { "$ref": "#/definitions/item" } },
          "passives": { "type": "array", "items": { "$ref": "#/definitions/item" } }
        }
      }
    }
  }
}
