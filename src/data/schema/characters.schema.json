{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Characters of a pack",
  "type": "object",
  "required": ["characters"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "source", "startingWeapons", "bonus", "secret", "verified"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/id" },
          "name": { "$ref": "common.schema.json#/definitions/name" },
          "nameDe": { "$ref": "common.schema.json#/definitions/nameDe" },
          "nameDeHint": { "$ref": "common.schema.json#/definitions/nameDeHint" },
          "source": { "$ref": "common.schema.json#/definitions/source" },
          "startingWeapons": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/definitions/id" },
            "uniqueItems": true,
            "description": "IDs of the starting weapons. Usually exactly one; may be empty."
          },
          "bonus": {
            "$ref": "common.schema.json#/definitions/localizedText",
            "description": "The character's special trait in one sentence."
          },
          "secret": {
            "type": "boolean",
            "description": "Secret character; can be hidden with the spoiler switch."
          },
          "unlock": { "type": "string", "description": "How to unlock the character." },
          "emoji": { "$ref": "common.schema.json#/definitions/emoji" },
          "icon": { "$ref": "common.schema.json#/definitions/icon" },
          "image": { "$ref": "common.schema.json#/definitions/image" },
          "verified": { "$ref": "common.schema.json#/definitions/verified" },
          "note": { "$ref": "common.schema.json#/definitions/localizedText" }
        }
      }
    }
  }
}
