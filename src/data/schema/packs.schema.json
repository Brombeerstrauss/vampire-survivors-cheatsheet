{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Content packs (base game and DLCs)",
  "type": "object",
  "required": ["packs"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "paid", "verified"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/id" },
          "name": { "$ref": "common.schema.json#/definitions/localizedText" },
          "kind": { "enum": ["base", "dlc"] },
          "paid": {
            "type": "boolean",
            "description": "Paid? Free content is preselected in the DLC filter."
          },
          "released": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Release date, YYYY-MM-DD."
          },
          "verified": { "$ref": "common.schema.json#/definitions/verified" }
        }
      }
    }
  }
}
