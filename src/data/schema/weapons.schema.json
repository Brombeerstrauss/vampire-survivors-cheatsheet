{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Weapons of a pack (base and evolved weapons)",
  "type": "object",
  "required": ["weapons"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "weapons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "source", "kind", "description", "maxLevel", "verified"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/id" },
          "gameIds": { "$ref": "common.schema.json#/definitions/gameIds" },
          "name": { "$ref": "common.schema.json#/definitions/name" },
          "nameDe": { "$ref": "common.schema.json#/definitions/nameDe" },
          "nameDeHint": { "$ref": "common.schema.json#/definitions/nameDeHint" },
          "source": { "$ref": "common.schema.json#/definitions/source" },
          "kind": {
            "enum": ["base", "evolved"],
            "description": "evolved = result of an evolution, union or gift."
          },
          "description": { "$ref": "common.schema.json#/definitions/localizedText", "description": "What the weapon does." },
          "effects": {
            "$ref": "common.schema.json#/definitions/localizedText",
            "description": "How the weapon works and what triggers it: the first paragraphs of the wiki's Effects section (tools/wiki-import/weapon_effects.py)."
          },
          "affectedBy": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["might", "area", "speed", "duration", "amount", "cooldown", "luck", "maxHealth", "recovery", "armor", "moveSpeed", "magnet", "growth", "greed", "curse", "revival"]
            },
            "description": "Stats that directly affect the weapon (wiki table Stats and passive items, value 1)."
          },
          "maxLevel": { "$ref": "common.schema.json#/definitions/maxLevel" },
          "exclusiveTo": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/definitions/id" },
            "minItems": 1,
            "uniqueItems": true,
            "description": "Only these characters can use the weapon. Leave out if anyone can."
          },
          "unlock": { "type": "string", "description": "How to unlock the weapon." },
          "emoji": { "$ref": "common.schema.json#/definitions/emoji" },
          "icon": { "$ref": "common.schema.json#/definitions/icon" },
          "image": { "$ref": "common.schema.json#/definitions/image" },
          "verified": { "$ref": "common.schema.json#/definitions/verified" },
          "note": { "$ref": "common.schema.json#/definitions/localizedText" }
        }
      }
    }
  }
}
