{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evolutions, unions and gifts of a pack",
  "type": "object",
  "required": ["evolutions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "evolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "source", "result", "weapons", "passives", "verified"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/id" },
          "kind": {
            "enum": ["evolution", "union", "gift", "morph"],
            "description": "evolution = the weapon is replaced, union = several weapons merge, gift = the base weapon stays and the result is added, morph = only for certain characters, automatic without a chest."
          },
          "source": { "$ref": "common.schema.json#/definitions/source" },
          "result": {
            "$ref": "common.schema.json#/definitions/id",
            "description": "ID of the evolved weapon (an entry with kind: evolved)."
          },
          "weapons": {
            "type": "array",
            "minItems": 1,
            "description": "Required weapons: one for evolutions, several for unions.",
            "items": {
              "type": "object",
              "required": ["id"],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "common.schema.json#/definitions/id" },
                "level": {
                  "$ref": "common.schema.json#/definitions/level",
                  "description": "Default: max."
                }
              }
            }
          },
          "passives": {
            "type": "array",
            "description": "Required passive items; may be empty.",
            "items": {
              "type": "object",
              "required": ["id"],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "common.schema.json#/definitions/id" },
                "level": {
                  "$ref": "common.schema.json#/definitions/level",
                  "description": "Default: any (owning it is enough)."
                },
                "consumed": {
                  "type": "boolean",
                  "description": "The item is used up by the evolution (e.g. Weapon Power-Up)."
                }
              }
            }
          },
          "characters": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/definitions/id" },
            "description": "Only possible with these characters (e.g. morphs). Leave out if it applies to everyone."
          },
          "conditions": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/definitions/localizedText" },
            "description": "Further conditions as text, e.g. a relic or a minimum level."
          },
          "verified": { "$ref": "common.schema.json#/definitions/verified" },
          "note": { "$ref": "common.schema.json#/definitions/localizedText" }
        }
      }
    }
  }
}
