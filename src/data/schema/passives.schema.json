{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Passive items of a pack",
  "type": "object",
  "required": ["passives"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "passives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "source", "description", "maxLevel", "verified"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/id" },
          "gameIds": { "$ref": "common.schema.json#/definitions/gameIds" },
          "name": { "$ref": "common.schema.json#/definitions/name" },
          "nameDe": { "$ref": "common.schema.json#/definitions/nameDe" },
          "nameDeHint": { "$ref": "common.schema.json#/definitions/nameDeHint" },
          "source": { "$ref": "common.schema.json#/definitions/source" },
          "description": { "$ref": "common.schema.json#/definitions/localizedText", "description": "What the item does." },
          "maxLevel": { "$ref": "common.schema.json#/definitions/maxLevel" },
          "stageOnly": {
            "type": "boolean",
            "description": "Only found as a pickup in stages, never offered on level-up."
          },
          "noSlot": {
            "type": "boolean",
            "description": "Does not take one of the 6 passive slots (e.g. gifts from DLCs)."
          },
          "ignoresSlotLimit": {
            "type": "boolean",
            "description": "Takes a slot but can be picked even when all slots are full (e.g. Mini Crewmates)."
          },
          "unlock": { "type": "string", "description": "How to unlock the item." },
          "emoji": { "$ref": "common.schema.json#/definitions/emoji" },
          "icon": { "$ref": "common.schema.json#/definitions/icon" },
          "image": { "$ref": "common.schema.json#/definitions/image" },
          "verified": { "$ref": "common.schema.json#/definitions/verified" },
          "note": { "$ref": "common.schema.json#/definitions/localizedText" }
        }
      }
    }
  }
}
