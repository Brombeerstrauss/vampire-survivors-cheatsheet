{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Passive Gegenstände eines Pakets",
  "type": "object",
  "required": ["passives"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "passives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "source", "description", "maxLevel", "verified"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/id" },
          "name": { "$ref": "common.schema.json#/definitions/name" },
          "nameDe": { "$ref": "common.schema.json#/definitions/nameDe" },
          "nameDeHint": { "$ref": "common.schema.json#/definitions/nameDeHint" },
          "source": { "$ref": "common.schema.json#/definitions/source" },
          "description": { "$ref": "common.schema.json#/definitions/localizedText", "description": "Wirkung des Gegenstands." },
          "maxLevel": { "$ref": "common.schema.json#/definitions/maxLevel" },
          "stageOnly": {
            "type": "boolean",
            "description": "Nur als Fundstück in der Stage erhältlich, nicht über Level-ups."
          },
          "noSlot": {
            "type": "boolean",
            "description": "Belegt keinen der 6 passiven Slots (z. B. Geschenke aus DLCs)."
          },
          "ignoresSlotLimit": {
            "type": "boolean",
            "description": "Belegt zwar einen Slot, kann aber auch bei vollen Slots gewählt werden (z. B. Mini Crewmates)."
          },
          "unlock": { "type": "string", "description": "Wie man den Gegenstand freischaltet." },
          "emoji": { "$ref": "common.schema.json#/definitions/emoji" },
          "icon": { "$ref": "common.schema.json#/definitions/icon" },
          "image": { "$ref": "common.schema.json#/definitions/image" },
          "verified": { "$ref": "common.schema.json#/definitions/verified" },
          "note": { "$ref": "common.schema.json#/definitions/localizedText" }
        }
      }
    }
  }
}
