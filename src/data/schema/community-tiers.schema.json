{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "General strength of weapons and passive items, from community tier lists",
  "description": "Independent of the character. Each tier is the weighted mean of the sources that rate the entry (S = 5, A = 4, B = 3, C = 2, D = 1, F = 0): at least 4.5 = tier 1, at least 3.5 = tier 2, at least 2.5 = tier 3. Entries below that are left out.",
  "type": "object",
  "required": ["sources", "tiers"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "url", "updated", "weight"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" },
          "updated": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Last update of the source, as the page states it."
          },
          "weight": { "type": "number", "exclusiveMinimum": 0, "description": "Weight in the mean, e.g. 2 for a current, detailed list." }
        }
      }
    },
    "tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "tier", "sources"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/id", "description": "ID of a weapon or passive item." },
          "tier": { "enum": [1, 2, 3], "description": "1 = strong, 2 = good, 3 = decent." },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/definitions/id" },
            "description": "IDs of the sources that rate this entry."
          }
        }
      }
    }
  }
}
